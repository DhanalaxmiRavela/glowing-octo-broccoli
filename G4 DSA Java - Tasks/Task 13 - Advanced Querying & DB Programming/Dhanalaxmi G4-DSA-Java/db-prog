Question 74 — calculate_order_total
CREATE OR REPLACE FUNCTION calculate_order_total(
    p_order_id INT
)
RETURNS NUMERIC(12,2)
LANGUAGE plpgsql
AS $$
DECLARE
    total_value NUMERIC(12,2);
BEGIN
    SELECT COALESCE(
        SUM(
            quantity *
            unit_price *
            (1 - discount / 100.0)
        ),
        0
    )
    INTO total_value
    FROM order_items
    WHERE order_id = p_order_id;

    RETURN total_value;
END;
$$;

