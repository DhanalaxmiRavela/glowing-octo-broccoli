Part 11: Recursive CTE
Question 51 — Complete category hierarchy
WITH RECURSIVE category_hierarchy AS (
    SELECT
        category_id,
        category_name,
        parent_category_id,
        0 AS level
    FROM categories
    WHERE parent_category_id IS NULL

    UNION ALL

    SELECT
        c.category_id,
        c.category_name,
        c.parent_category_id,
        ch.level + 1
    FROM categories c
    JOIN category_hierarchy ch
        ON c.parent_category_id = ch.category_id
)
SELECT
    category_id,
    category_name,
    parent_category_id,
    level
FROM category_hierarchy
ORDER BY level, category_id;
